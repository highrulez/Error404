# OneFlow public URL
NEXT_PUBLIC_APP_URL=https://oneflow.highrulez.com

# Prototype email provider. Saved Admin settings take precedence over these defaults.
EMAIL_MODE=mock
AWS_REGION=ap-southeast-1
SES_FROM_EMAIL=
SES_FROM_NAME=OneFlow

# Required only when SES delivery is enabled. Keep real values server-side.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
